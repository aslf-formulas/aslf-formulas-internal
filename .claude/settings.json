{
  "permissions": {
    "allow": [
      "Bash(git mv *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(cd * && git add *)",
      "Bash(cd * && git commit *)",
      "Bash(cd * && git push *)",
      "Bash(cd * && git mv *)",
      "Bash(cd * && git add * && git commit *)",
      "Bash(cd * && mkdir * && git mv *)",
      "Bash(cd * && git add * && git commit * && git push *)",
      "Bash(mkdir *)"
    ]
  }
}
